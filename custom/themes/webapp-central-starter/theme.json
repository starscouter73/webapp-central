{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "background",
          "name": "Background",
          "color": "#efe8e0"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#e6dbcf"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "#2b221b"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#615348"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#6f5e4e"
        },
        {
          "slug": "accent-strong",
          "name": "Accent Strong",
          "color": "#514233"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "color": {
      "background": "#efe8e0",
      "text": "#2b221b"
    },
    "typography": {
      "fontFamily": "\"Segoe UI\", \"Helvetica Neue\", sans-serif",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#6f5e4e"
        }
      }
    }
  }
}
