{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "background",
          "name": "Background",
          "color": "#050505"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#111111"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#d4d4d8"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#efff3d"
        },
        {
          "slug": "accent-strong",
          "name": "Accent Strong",
          "color": "#f4ff45"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true
    }
  },
  "styles": {
    "color": {
      "background": "#050505",
      "text": "#ffffff"
    },
    "typography": {
      "fontFamily": "\"Aptos\", \"Segoe UI\", sans-serif",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#efff3d"
        }
      }
    }
  }
}
